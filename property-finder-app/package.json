{
  "name": "property-finder-app",
  "version": "1.0.0",
  "description": "AI-powered property finder with ML price prediction",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/server.js",
    "client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "mobile:build": "npm run build && npx cap sync android",
    "mobile:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@tensorflow/tfjs": "^4.11.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.4",
    "express": "^4.18.2",
    "mongodb": "^7.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.2.1",
    "vite": "^4.4.9"
  }
}
