# MongoDB Atlas connection string. Keep this secret out of Git.
# Required for production deployments so application data survives restarts.
MONGODB_URI=
MONGODB_DATABASE=property_finder

# Optional API base URL. Set this to the deployed Render API to share data
# between the local website and the mobile app.
# VITE_API_URL=https://your-service.onrender.com/api

# Optional local SQLite database location.
# PROPERTY_DATABASE_PATH=
