# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Configuration
VITE_API_URL=http://localhost:5000/api

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Database Configuration (for future MongoDB integration)
MONGODB_URI=mongodb://localhost:27017/property-finder
DB_NAME=property-finder

# Map Configuration
MAP_CENTER_LAT=28.6139
MAP_CENTER_LNG=77.2090
MAP_DEFAULT_ZOOM=12

# ML Model Configuration
ML_TRAINING_EPOCHS=100
ML_BATCH_SIZE=2
ML_LEARNING_RATE=0.01

# Feature Flags
ENABLE_ML_PREDICTIONS=true
ENABLE_PRICE_HISTORY=false
ENABLE_USER_REVIEWS=false
